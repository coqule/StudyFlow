# Supabase — solo la anon key llega al frontend (nunca la service role key,
# ver docs/architecture.md §5). Se usa exclusivamente para auth.* (login,
# registro, logout, restauración de sesión) — nunca para leer/escribir datos
# de negocio (docs/architecture.md §2).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base URL del backend (docs/api-contratos.md) — usada por
# frontend/src/services/cursosApi.ts para las llamadas HTTP/REST con JWT
# (docs/architecture.md §2, "Frontend → Backend únicamente vía HTTP/REST").
VITE_API_URL=http://localhost:3001/api
